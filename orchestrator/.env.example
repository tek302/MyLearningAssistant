# Environment variables for the orchestrator
# Copy this file to .env and fill in your values

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Firebase Configuration (required for token verification unless bypass is used)
# Option (a): File path — recommended for Cloud Run (mount secret as file)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Option (b): File path or JSON string — fallback
FIREBASE_SERVICE_ACCOUNT_JSON=path/to/firebase-service-account.json

# Auth bypass (dev only): set only when APP_ENV=local or DEBUG=true
# When set, Authorization: Bearer <this_value> is accepted as user_id (e.g. dev-user)
AUTH_BYPASS_USER_ID=

# Application Environment
# Options: local, development, staging, production
APP_ENV=local

# Debug mode (if true, allows AUTH_BYPASS_USER_ID when set)
DEBUG=false

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# OpenAI Embedding Model
# Default: text-embedding-3-small (1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI Summary Model
# Default: gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini

# S1 Summarization Configuration
# Maximum number of chunks to use for S1 summary (default: 8)
S1_MAX_CHUNKS=8

# PDF Processing Configuration
# Maximum PDF file size in MB (default: 25)
MAX_PDF_MB=25

# Maximum PDF pages to process (default: 100)
MAX_PDF_PAGES=100

# Text Extraction Configuration
# Minimum text length required (default: 100 characters)
MIN_TEXT_LENGTH=100
