# Environment variables for the orchestrator
# Copy this file to .env and fill in your values

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Optional: for Docker when DB host resolves to IPv6 only. Same URL but host replaced with IPv4 (from nslookup A record).
# DATABASE_URL_IPV4=postgresql://postgres:[password]@1.2.3.4:5432/postgres

# Firebase Configuration (required for token verification unless bypass is used)
# Option (a): File path — recommended for Cloud Run (mount secret as file)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Option (b): File path or JSON string — fallback
FIREBASE_SERVICE_ACCOUNT_JSON=path/to/firebase-service-account.json

# Auth bypass (dev only): set only when APP_ENV=local or DEBUG=true
# When set, Authorization: Bearer <this_value> is accepted as user_id (e.g. dev-user)
AUTH_BYPASS_USER_ID=

# Application Environment
# Options: local, development, staging, production
APP_ENV=local

# Debug mode (if true, allows AUTH_BYPASS_USER_ID when set)
DEBUG=false

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# OpenAI Embedding Model
# Default: text-embedding-3-small (1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI Summary Model
# Default: gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini

# S1 Summarization Configuration (Feed card: tldr up to 3 sentences + key points)
# Maximum number of chunks to use for S1 summary (default: 12)
S1_MAX_CHUNKS=12
# TLDR max characters (default: 250)
S1_TLDR_MAX_CHARS=250
# TLDR max sentences (default: 3); includes paper contribution/achievement when relevant
S1_TLDR_MAX_SENTENCES=3
# Number of key bullet points (default: 3)
# S1_BULLETS_COUNT=3

# PDF Processing Configuration
# Maximum PDF file size in MB (default: 25)
MAX_PDF_MB=25

# Maximum PDF pages to process (default: 100)
MAX_PDF_PAGES=100

# Text Extraction Configuration
# Minimum text length required (default: 100 characters)
MIN_TEXT_LENGTH=100

# RAG Debug (set to true to include context_preview and eval info in /rag/answer meta.debug)
# RAG_DEBUG=false

# LLM Judge (if true, RAG answer is evaluated by a judge model; failure can trigger refine or fallback)
# JUDGE_ENABLED=false

# Worker tick (Cloud Scheduler): when set, POST /worker/tick requires header X-Worker-Tick-Secret to match
# WORKER_TICK_SECRET=

# Local only: skip SSL verification when fetching PDFs (e.g. Windows cert store issues). Only when APP_ENV=local or DEBUG=true.
# SKIP_SSL_VERIFY=true
